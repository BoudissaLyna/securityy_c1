{
  "name": "dns-tunnel-sentinel",
  "private": true,
  "version": "2.4.1",
  "description": "DNS Tunneling Detection & Blocking Desktop Application",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
